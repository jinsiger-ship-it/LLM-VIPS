// Diamond Memories — 동작 코드
// 별도 설치나 API 키 없이 실행되며 데이터는 현재 브라우저에만 저장됩니다.

// DOM 검색을 짧게 쓰는 도우미와 화면을 표시할 영역입니다.
const $ = s => document.querySelector(s),
  app = $('#app');
// 사용자 입력의 HTML 특수문자를 바꿔, 입력 내용이 태그로 실행되지 않도록 합니다.
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({
  '&': '&amp;',
  '<': '&lt;',
  '>': '&gt;',
  '"': '&quot;',
  "'": '&#39;'
})[c]);
// 브라우저에 저장할 데이터: 티켓, 획득 아이템, 칭호, 대표 티켓 ID입니다. 기존 저장값을 불러옵니다.
let state = {
  tickets: [],
  rewards: [],
  titles: [],
  featured: null
};
try {
  Object.assign(state, JSON.parse(localStorage.getItem('diamond-v1') || '{}'));
} catch {}
;
// 현재 화면과 작성 중인 티켓, 수정 대상 ID, 게임 진행 상태입니다.
let view = 'home',
  draft = null,
  editing = null,
  step = 0,
  points = 0,
  history = [];
// 티켓이 없을 때 홈에 보여주는 예시 데이터입니다. 실제 경기 기록이 아닙니다.
const sample = {
  date: '2026-10-24',
  stadium: '잠실 야구장',
  home: '우리 팀',
  away: '상대 팀',
  hs: 5,
  as: 4,
  mode: '직관',
  note: '9회 말, 우리가 함께 만든 기적.',
  theme: 'classic',
  sticker: '⚾'
};
// 현재 데이터를 localStorage에 JSON으로 저장합니다. 용량 부족 등으로 실패하면 false를 반환합니다.
function save() {
  try {
    localStorage.setItem('diamond-v1', JSON.stringify(state));
    return true;
  } catch {
    toast('저장 공간이 부족합니다. 사진 크기를 줄여 주세요.');
    return false;
  }
}
// 화면 하단에 잠시 나타나는 알림을 표시합니다.
function toast(s) {
  $('#toast').textContent = s;
  $('#toast').style.display = 'block';
  clearTimeout(window.tt);
  window.tt = setTimeout(() => $('#toast').style.display = 'none', 3000);
}
// 티켓 데이터로 공통 HTML을 만듭니다. 홈, 미리보기, 수집함에서 함께 사용합니다.
function ticket(t) {
  return `<article class="ticket ${esc(t.theme)}"><div class="ticket-top"><span>DIAMOND MEMORIES</span><span>${esc(t.sticker || '◇')}</span></div><div class="ticket-body"><div class="stadium">${esc(t.date)} · ${esc(t.stadium)}</div><h3>${esc(t.home)}<br><small style="font-size:13px;font-weight:400">VS</small> ${esc(t.away)}</h3><div class="score">${esc(t.hs)} <span style="font-weight:400;color:#9aab91">:</span> ${esc(t.as)}</div>${t.photo ? `<img src="${t.photo}" alt="경기 추억 사진">` : ''}<p class="ticket-note">${esc(t.note)}</p></div><div class="ticket-bottom"><span>${esc(t.mode)} · 기념용<br>KEEP THE MOMENT</span><div class="barcode" aria-hidden="true"></div></div></article>`;
}
// 화면을 전환하고 메뉴의 선택 표시를 갱신합니다.
function go(v) {
  view = v;
  document.querySelectorAll('nav button').forEach(b => b.classList.toggle('active', b.dataset.view === v));
  render();
  window.scrollTo(0, 0);
}
// 이벤트 위임: 나중에 생성된 버튼도 data-view 속성이 있으면 화면 이동을 처리합니다.
document.addEventListener('click', e => {
  const b = e.target.closest('[data-view]');
  if (b) {
    if (b.dataset.view === 'create') {
      draft = null;
      editing = null;
    }
    go(b.dataset.view);
  }
});
// 현재 화면 이름에 해당하는 렌더링 함수를 호출합니다.
function render() {
  if (view === 'home') home();
  if (view === 'create') create();
  if (view === 'collection') collection();
  if (view === 'game') game();
}
// 홈: 대표 티켓 또는 샘플 티켓, 기능 소개와 이동 버튼을 표시합니다.
function home() {
  const featured = state.tickets.find(t => t.id === state.featured) || sample;
  app.innerHTML = `<section class="hero"><div><div class="eyebrow"><i class="dot"></i> YOUR GAME. YOUR STORY.</div><h1>그날의 함성,<br><em>나만의 티켓으로.</em></h1><p>짜릿했던 끝내기, 함께 부른 응원가.<br>잊고 싶지 않은 야구의 순간을 만들고, 꾸미고, 모아보세요.</p><div class="actions"><button class="btn" data-view="create">첫 번째 티켓 만들기 ↗</button><button class="btn secondary" data-view="game">감독이 되어보기 →</button></div><p class="muted" style="margin-top:28px">${state.tickets.length}장의 추억 · ${state.rewards.length}개의 꾸미기 보상</p></div><div class="hero-art"><div class="diamond"></div>${ticket(featured)}<span class="art-label">A MOMENT WORTH KEEPING</span></div></section><div class="section-head"><h2>추억이 컬렉션이 되는 방법</h2><span>MAKE IT. PLAY IT. KEEP IT.</span></div><section class="features"><div class="feature"><span class="num">01 /</span><h3>나만의 경기 티켓</h3><p>직관부터 중계 관람까지, 기억하고 싶은 경기를 기록해요.</p><button data-view="create">티켓 만들기 ↗</button></div><div class="feature"><span class="num">02 /</span><h3>9회 말, 당신의 선택</h3><p>더그아웃의 감독이 되어 선택하고 특별한 보상을 얻어요.</p><button data-view="game">게임 플레이 ↗</button></div><div class="feature"><span class="num">03 /</span><h3>쌓여가는 야구의 순간</h3><p>획득한 아이템으로 티켓을 꾸미고 나만의 수집함에 간직해요.</p><button data-view="collection">수집함 보기 ↗</button></div></section>`;
}
// 티켓 작성/수정: 입력 폼과 실시간 미리보기를 연결하고, 필수값과 점수를 확인한 뒤 저장합니다.
function create() {
  draft ??= {
    date: new Date().toLocaleDateString('sv-SE'),
    stadium: '',
    home: '',
    away: '',
    hs: 0,
    as: 0,
    mode: '직관',
    note: '',
    theme: 'classic',
    sticker: ''
  };
  app.innerHTML = `<div class="eyebrow">MAKE A MEMORY</div><h1 class="page-title">나만의 기념 티켓</h1><p>경기의 숫자와 그날의 마음을 함께 담아보세요.</p><div class="workspace"><section class="panel"><form id="ticket-form"><div class="form-grid">${field('date', '경기 날짜', 'date')}${field('stadium', '야구장', 'text', '예: 잠실 야구장')}${field('home', '응원 팀', 'text', '예: 서울 히어로즈')}${field('away', '상대 팀', 'text', '예: 부산 웨이브')}${field('hs', '응원 팀 점수', 'number')}${field('as', '상대 팀 점수', 'number')}<label class="full">관람 방식<select name="mode">${['직관', '중계 관람', '기념 경기'].map(s => `<option ${s === draft.mode ? 'selected' : ''}>${s}</option>`).join('')}</select></label><label class="full">한 줄 감상<textarea name="note" maxlength="80" placeholder="그날을 떠올리면 어떤 마음인가요?">${esc(draft.note)}</textarea></label><label class="full">추억 사진 (선택)<input id="photo" type="file" accept="image/*"></label></div><p class="muted">사진은 작게 압축해 저장합니다. 데이터는 현재 브라우저에 보관됩니다.</p><h3 style="font-size:14px">티켓 꾸미기</h3><div id="custom"></div><div class="actions"><button type="submit" class="btn">${editing ? '수정한 티켓 저장' : '수집함에 저장'} ↗</button>${draft.photo ? '<button type="button" class="btn secondary" id="remove-photo">사진 제거</button>' : ''}</div></form></section><section class="preview" id="preview">${ticket(draft)}</section></div>`;
  custom();
  $('#ticket-form').addEventListener('input', e => {
    if (e.target.name) {
      draft[e.target.name] = e.target.value;
      $('#preview').innerHTML = ticket(draft);
    }
  });
  $('#photo').onchange = upload;
  $('#remove-photo')?.addEventListener('click', () => {
    delete draft.photo;
    create();
  });
  $('#ticket-form').onsubmit = e => {
    e.preventDefault();
    for (const k of ['date', 'stadium', 'home', 'away']) if (!String(draft[k]).trim()) {
      toast('날짜, 구장, 두 팀 이름을 입력해 주세요.');
      return;
    }
    if (![draft.hs, draft.as].every(n => Number.isInteger(+n) && +n >= 0 && +n <= 99)) {
      toast('점수는 0~99의 정수로 입력해 주세요.');
      return;
    }
    const t = {
      ...draft,
      id: editing || crypto.randomUUID()
    };
    const previous = state.tickets;
    state.tickets = editing ? state.tickets.map(x => x.id === editing ? t : x) : [t, ...state.tickets];
    if (save()) {
      draft = null;
      editing = null;
      go('collection');
      toast('경기의 순간을 저장했습니다.');
    } else state.tickets = previous;
  };
}
// 반복되는 입력 필드를 만드는 함수입니다. 점수 입력은 0~99 정수로 제한합니다.
function field(name, label, type, placeholder = '') {
  return `<label>${label}<input name="${name}" type="${type}" value="${esc(draft[name])}" ${type === 'number' ? 'min="0" max="99" step="1"' : ''} placeholder="${placeholder}" required></label>`;
}
// 꾸미기 선택 버튼을 만듭니다. 미획득 보상은 비활성화하고 선택값을 미리보기에 적용합니다.
function custom() {
  const items = [['classic', '기본 티켓', null], ['gold', '금빛 프레임', 'gold'], ['night', '야간 경기 배경', 'night']];
  $('#custom').innerHTML = `<div class="custom">${items.map(([v, l, r]) => `<button type="button" data-theme="${v}" ${r && !state.rewards.includes(r) ? 'disabled' : ''} class="${draft.theme === v ? 'selected' : ''}">${r && !state.rewards.includes(r) ? '🔒 ' : ''}${l}</button>`).join('')}</div><div class="custom">${[['', '스티커 없음', null], ['⚾', '야구공', null], ['🏆', '우승 트로피', 'trophy']].map(([v, l, r]) => `<button type="button" data-sticker="${v}" ${r && !state.rewards.includes(r) ? 'disabled' : ''} class="${draft.sticker === v ? 'selected' : ''}">${r && !state.rewards.includes(r) ? '🔒 ' : ''}${l}</button>`).join('')}</div><p class="muted">잠긴 아이템은 더그아웃 게임에서 획득할 수 있어요.</p>`;
  document.querySelectorAll('[data-theme],[data-sticker]').forEach(b => b.onclick = () => {
    if (b.hasAttribute('data-theme')) draft.theme = b.dataset.theme;else draft.sticker = b.dataset.sticker;
    $('#preview').innerHTML = ticket(draft);
    custom();
  });
}
// 사진을 읽어 긴 변을 최대 800px로 줄인 뒤 JPEG로 압축합니다. Base64 문자열을 티켓에 저장합니다.
async function upload(e) {
  const f = e.target.files[0];
  if (!f) return;
  if (!f.type.startsWith('image/')) {
    toast('이미지 파일을 선택해 주세요.');
    return;
  }
  try {
    const bitmap = await createImageBitmap(f),
      c = document.createElement('canvas'),
      ratio = Math.min(1, 800 / Math.max(bitmap.width, bitmap.height));
    c.width = bitmap.width * ratio;
    c.height = bitmap.height * ratio;
    c.getContext('2d').drawImage(bitmap, 0, 0, c.width, c.height);
    draft.photo = c.toDataURL('image/jpeg', .7);
    bitmap.close();
    $('#preview').innerHTML = ticket(draft);
    toast('사진을 추가했습니다.');
  } catch {
    toast('이 사진을 읽을 수 없습니다. JPG 또는 PNG를 사용해 주세요.');
  }
}
// 수집함: 저장한 티켓과 칭호를 표시하고, 수정·대표 지정·삭제 버튼을 연결합니다.
function collection() {
  app.innerHTML = `<div class="eyebrow">MY LITTLE HALL OF FAME</div><div class="section-head" style="margin-top:10px"><h1 class="page-title">나의 수집함 <small style="font-size:18px;color:#829076">${state.tickets.length}</small></h1><button class="btn" data-view="create">+ 새 티켓</button></div><div class="rewards"><span class="badge">${state.rewards.length}개의 보상</span>${state.titles.map(t => `<span class="badge">✦ ${esc(t)}</span>`).join('')}</div>${state.tickets.length ? `<div class="collection">${state.tickets.map(t => `<div>${t.id === state.featured ? '<p class="muted">★ 대표 티켓</p>' : ''}${ticket(t)}<div class="card-actions"><button class="btn secondary" data-edit="${t.id}">꾸미기 / 수정</button><button class="btn secondary" data-star="${t.id}">대표 지정</button><button class="btn secondary" data-delete="${t.id}" aria-label="티켓 삭제">×</button></div></div>`).join('')}</div>` : `<div class="empty"><h2>첫 번째 순간을 기다리고 있어요.</h2><p>나에게 특별했던 경기를 티켓 한 장으로 남겨보세요.</p><button class="btn" data-view="create">첫 티켓 만들기 ↗</button></div>`}`;
  document.querySelectorAll('[data-edit]').forEach(b => b.onclick = () => {
    editing = b.dataset.edit;
    draft = {
      ...state.tickets.find(t => t.id === editing)
    };
    go('create');
  });
  document.querySelectorAll('[data-star]').forEach(b => b.onclick = () => {
    state.featured = b.dataset.star;
    if (save()) {
      collection();
      toast('홈에 전시할 대표 티켓을 지정했습니다.');
    }
  });
  document.querySelectorAll('[data-delete]').forEach(b => b.onclick = () => {
    if (confirm('이 티켓을 삭제할까요?')) {
      state.tickets = state.tickets.filter(t => t.id !== b.dataset.delete);
      if (state.featured === b.dataset.delete) state.featured = null;
      save();
      collection();
    }
  });
}
// 게임 콘텐츠: 5개 상황과 선택지입니다. 각 선택지는 [표시 문구, 점수] 형태이며 점수를 합산합니다.
const scenes = [{
  title: '한 점 차, 마지막 공격의 시작',
  text: '9회 말 3:4. 무사 1루, 발 빠른 주자가 나갔습니다. 상대 투수는 제구가 흔들리고 있습니다.',
  options: [['초구부터 강공으로 압박한다', 2], ['희생 번트로 득점권에 보낸다', 1], ['공을 지켜보며 투구 수를 늘린다', 0]]
}, {
