  options: [['바깥쪽 공을 밀어 치도록 지시한다', 2], ['장타를 노리고 크게 휘두른다', 0], ['짧게 잡고 인플레이 타구를 만든다', 1]]
}, {
  title: '승부를 걸어야 할 시간',
  text: '동점 적시타! 4:4, 1사 1루. 벤치에는 장타형 대타와 수비형 선수가 남았습니다.',
  options: [['장타형 대타로 끝내기를 노린다', 2], ['기존 타자의 흐름을 믿는다', 1], ['수비형 선수를 투입해 연장에 대비한다', 0]]
}, {
  title: '더그아웃의 한마디',
  text: '파울 타구가 연달아 나옵니다. 타자가 벤치 쪽을 바라봅니다. 긴장이 구장을 가득 채웠습니다.',
  options: [['네 타이밍이야. 자신 있게!', 2], ['정확하게 맞히는 데 집중하자', 1], ['볼넷도 괜찮아. 기다려 보자', 0]]
}, {
  title: '홈으로 향하는 순간',
  text: '우중간을 가르는 안타! 2사, 주자가 3루를 돌아갑니다. 외야수의 송구가 곧 도착합니다.',
  options: [['주자의 발을 믿고 홈으로 보낸다', 2], ['3루에 멈추고 다음 타자를 믿는다', 1], ['협살을 피하며 안전하게 플레이한다', 0]]
}];
// 게임의 공통 화면과 점수판을 표시한 뒤 현재 장면을 그립니다.
function game() {
  app.innerHTML = `<div class="eyebrow">THE DUGOUT · CHAPTER 01</div><h1 class="page-title">9회 말, 당신의 선택</h1><p>감독의 다섯 번의 선택. 마지막 아웃까지 이야기는 끝나지 않습니다.</p><section class="game"><div class="scoreboard"><span>AWAY 4</span><b>9회 말 · HOME ${step > 1 ? '4' : '3'}</b><span>시나리오 게임</span></div><div class="panel" id="scene"></div></section>`;
  drawScene();
}
// 진행 중에는 선택지를 표시합니다. 5번 선택 후 총점 0~3/4~7/8~10에 따라 결말과 보상을 지급합니다.
// 같은 보상과 칭호는 중복 추가하지 않습니다. 실제 확률 경기 시뮬레이션이 아닌 점수형 프로토타입입니다.
function drawScene() {
  if (step >= 5) {
    const level = points >= 8 ? 2 : points >= 4 ? 1 : 0;
    const endings = [['연장의 승부사', '안전한 운영으로 경기를 연장으로 이끌었습니다. 끝까지 포기하지 않은 감독에게 야간 경기 배경을 드립니다.', 'night', '야간 경기 배경'], ['끈기의 감독', '찬스를 이어간 타선이 밀어내기 볼넷으로 결승점을 만들었습니다. 차분한 승부에 금빛 프레임을 드립니다.', 'gold', '금빛 프레임'], ['끝내기의 주인공', '과감한 작전과 자신감 있는 타격! 주자가 홈을 밟으며 극적인 끝내기 승리를 완성했습니다.', 'trophy', '우승 트로피 스티커']];
    const [title, text, reward, label] = endings[level];
    if (!state.rewards.includes(reward)) state.rewards.push(reward);
